#!/usr/bin/env bash

ACTION="$1"
# If no path is provided, use the current directory
REPO_PATH="${2:-.}"
# If no branch is provided, default to main
BRANCH="${3:-main}"

# 1. Validate the action parameter
if [ -z "$ACTION" ]; then
    echo "Usage: auto-git <command> [path] [branch]"
    echo ""
    echo "Commands:"
    echo "  commit   -> Stage changes and commit using Gemini AI"
    echo "  amend    -> Rewrite the last commit message using Gemini AI"
    echo "  push     -> Push changes (Auto-converts HTTPS to SSH)"
    echo "  sync     -> Run commit then push sequentially"
    exit 1
fi

# 2. Navigate to the path and verify it is a Git repository
cd "$REPO_PATH" || { echo "[ERROR] Invalid path: $REPO_PATH"; exit 1; }

if [ ! -d ".git" ]; then
    echo "[ERROR] Not a git repository: $(pwd)"
    exit 1
fi

# ==========================================
# Function 1: Commit
# ==========================================
do_commit() {
    if git diff --quiet && git diff --cached --quiet; then
        echo "[INFO] No local changes to commit."
        return 0
    fi

    git add -A
    echo "[INFO] Analyzing changes with Gemini..."

    MESSAGE=$(git diff --cached | gemini -y -m flash-lite -o text "Write a professional multi-line git commit message based on this diff following conventional commit guidelines. Include a concise summary line (max 50 chars), followed by a blank line, and then a detailed description explaining what was changed and why. Output ONLY the raw commit message text. Do NOT wrap it in markdown code blocks, quotes, or add any extra metadata or explanations.")

    if [ -z "$MESSAGE" ]; then
        echo "[WARN] Gemini failed to generate a message. Using default fallback."
        MESSAGE="auto commit: $(date '+%Y-%m-%d %H:%M:%S')

Automated synchronization of repository changes."
    fi

    MESSAGE="$MESSAGE

    Automated commit generated by auto-git
    Author: 0xSA7
    Project: https://github.com/0xSA7/auto-git"

    echo -e "[INFO] Commit Message Generated:\n------------------------------\n$MESSAGE\n------------------------------"
    git commit -m "$MESSAGE"
}

# ==========================================
# Function 2: Amend
# ==========================================
do_amend() {
    echo "[INFO] Analyzing the last commit with Gemini..."

    # Extract the diff of the last commit (and any newly staged files)
    DIFF=$(git diff --cached HEAD~1)

    if [ -z "$DIFF" ]; then
        echo "[INFO] No changes found to amend."
        return 0
    fi

    MESSAGE=$(echo "$DIFF" | gemini -y -m flash-lite -o text "Write a professional multi-line git commit message based on this diff following conventional commit guidelines. Include a concise summary line (max 50 chars), followed by a blank line, and then a detailed description explaining what was changed and why. Output ONLY the raw commit message text. Do NOT wrap it in markdown code blocks, quotes, or add any extra metadata or explanations.")

    if [ -z "$MESSAGE" ]; then
        echo "[ERROR] Gemini failed to generate a message. Aborting amend."
        exit 1
    fi

     MESSAGE="$MESSAGE

	      Automated commit generated by auto-git
	      Author: 0xSA7
	      Project: https://github.com/0xSA7/auto-git"

    echo -e "[INFO] Amended Commit Message Generated:\n------------------------------\n$MESSAGE\n------------------------------"
    
    # Apply the amend with the new message
    git commit --amend -m "$MESSAGE"
}

# ==========================================
# Function 3: Push
# ==========================================
do_push() {
   # Verify the repo has at least one commit
    if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
        echo "[ERROR] No commits found. Please commit at least once manually before pushing."
        exit 1
    fi

    # Fix HTTPS to SSH if needed
    REMOTE_URL=$(git remote get-url origin 2>/dev/null)
    if echo "$REMOTE_URL" | grep -q "^https://github.com"; then
        echo "[WARN] HTTPS remote detected. Switching to SSH..."
        SSH_URL=$(echo "$REMOTE_URL" | sed 's#https://github.com/#git@github.com:#')
        git remote set-url origin "$SSH_URL"
        echo "[INFO] Remote updated to SSH: $SSH_URL"
    fi

    git fetch origin "$BRANCH" >/dev/null 2>&1

    LOCAL=$(git rev-parse HEAD)
    REMOTE=$(git rev-parse "origin/$BRANCH" 2>/dev/null)

    if [ -z "$REMOTE" ]; then
        echo "[INFO] No remote branch found. Initial push..."
        if git push -u origin "$BRANCH"; then
            echo "[INFO] Initial push completed."
        else
            echo "[ERROR] Push failed."
            exit 1
        fi
        return 0
    fi

    if [ "$LOCAL" != "$REMOTE" ]; then
        echo "[INFO] Pushing changes..."
        if git push origin "$BRANCH"; then
            echo "[INFO] Pushed changes successfully."
        else
            echo "[ERROR] Push failed."
            exit 1
        fi
    else
        echo "[INFO] Already up to date. Nothing to push."
    fi
}

# ==========================================
# Execute the requested action
# ==========================================
case "$ACTION" in
    commit)
        do_commit
        ;;
    amend)
        do_amend
        ;;
    push)
        do_push
        ;;
    sync)
        do_commit
        do_push
        ;;
    *)
        echo "[ERROR] Unknown command: $ACTION"
        echo "Valid commands are: commit, amend, push, sync"
        exit 1
        ;;
esac
